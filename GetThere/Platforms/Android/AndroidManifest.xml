<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<!--
		Backup stays on — losing a wallet's settings on a handset swap would be a poor trade — but the
		cached tickets are excluded from it. They hold barcode payloads, which are bearer credentials
		for travel. Both rule files say the same thing because Android picks by API level:
		fullBackupContent applies on 23-30, dataExtractionRules on 31+.
	-->
	<application android:allowBackup="true" android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round" android:supportsRtl="true" android:usesCleartextTraffic="false" android:networkSecurityConfig="@xml/network_security_config" android:fullBackupContent="@xml/backup_rules" android:dataExtractionRules="@xml/data_extraction_rules"></application>
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
	<uses-permission android:name="android.permission.INTERNET" />

	<!--
		Ticket import: photographing a ticket or scanning its code, and picking an existing
		screenshot or e-ticket. READ_MEDIA_IMAGES replaced READ_EXTERNAL_STORAGE for images in
		Android 13, so the older one is declared but capped below that.
	-->
	<uses-permission android:name="android.permission.CAMERA" />
	<uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
	<uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

	<!-- Optional: a device without a camera can still import files and enter tickets by hand. -->
	<uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>