<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Navigation shell for both shapes in "GetThere App.dc.html":

      · phone / tablet — the bottom tab bar of frames 3a–3f
      · desktop        — the locked 220px side rail of frames 3g/3h

    Shell cannot switch a TabBar into a flyout at runtime, so the items are built in the
    code-behind against the device idiom rather than declared here.
-->
<Shell
    x:Class="GetThere.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:GetThere.Pages"
    xmlns:local="clr-namespace:GetThere"
    xmlns:localization="clr-namespace:GetThere.Localization"
    Title="GetThere"
    Shell.NavBarIsVisible="False"
    FlyoutBackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource DarkSurface}}"
    Shell.TabBarBackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource DarkSurface}}"
    Shell.TabBarForegroundColor="{StaticResource StatusOkStrong}"
    Shell.TabBarTitleColor="{StaticResource StatusOkStrong}"
    Shell.TabBarUnselectedColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource TextMuted}}" />
