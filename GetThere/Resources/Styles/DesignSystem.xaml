<?xml version="1.0" encoding="UTF-8" ?>
<!--
    GetThere design system — the MAUI half of the Claude Design project "GetThere".
    Source of truth: "GetThere App.dc.html" (frames 3a–3l).

    Colours live in Colors.xaml and mean the same thing here, in both admin consoles
    and in the design file. Everything below is the *shape* of the system: the type
    scale, the surfaces, the controls. Pages should reach for these styles rather
    than restating radii, paddings and hexes — when the design moves, this file moves
    and the screens follow.

    Every style is theme-aware: the design is dark-first, so the Dark value is the
    design's own and the Light value is its partner from Colors.xaml.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls">

    <!-- ══════════════════════════════════════════════════════════
         TYPE
         The design uses Open Sans throughout and IBM Plex Mono for
         technical captions (IDs, feed ages, section labels). Plex
         is not licensed into this repo, so DsMono falls back to the
         platform's own monospace face, which reads the same way.
         ══════════════════════════════════════════════════════════ -->

    <Style x:Key="DsPageTitle" TargetType="Label">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimary}}" />
    </Style>

    <Style x:Key="DsPageSubtitle" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource Gray400}}" />
    </Style>

    <Style x:Key="DsScreenTitle" TargetType="Label">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimary}}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!--  "NEAR YOU", "OPTIONS FROM OPERATOR", "RESULTS · OTP"  -->
    <Style x:Key="DsSectionCaption" TargetType="Label">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="1.6" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextDimLight}, Dark={StaticResource TextFaint}}" />
    </Style>

    <Style x:Key="DsCardTitle" TargetType="Label">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource White}}" />
    </Style>

    <Style x:Key="DsCardSubtitle" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource Gray400}}" />
    </Style>

    <!--  small all-caps key above a value, e.g. DEPARTS / ARRIVES / SEAT / PAID  -->
    <Style x:Key="DsMetaCaption" TargetType="Label">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMuted}}" />
    </Style>

    <Style x:Key="DsMetaValue" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource White}}" />
    </Style>

    <Style x:Key="DsMono" TargetType="Label">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextDim}}" />
        <Setter Property="FontFamily">
            <Setter.Value>
                <OnPlatform x:TypeArguments="x:String">
                    <On Platform="WinUI" Value="Consolas" />
                    <On Platform="iOS, MacCatalyst" Value="Menlo" />
                    <On Platform="Android" Value="monospace" />
                </OnPlatform>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DsFieldLabel" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource White}}" />
    </Style>

    <Style x:Key="DsErrorLabel" TargetType="Label">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource StatusDanger}, Dark={StaticResource StatusDangerText}}" />
    </Style>

    <Style x:Key="DsLinkLabel" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource TealText}}" />
    </Style>

    <!-- ══════════════════════════════════════════════════════════
         SURFACES
         ══════════════════════════════════════════════════════════ -->

    <!--  the standard content card: #111827 on #0F172A, hairline border, 16px radius  -->
    <Style x:Key="DsCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource DarkSurface}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource DarkSurfaceAlt}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <shapes:RoundRectangle CornerRadius="16" />
            </Setter.Value>
        </Setter>
    </Style>

    <!--  same card, larger radius — used where a card is the whole screen's subject  -->
    <Style x:Key="DsCardLarge" TargetType="Border" BasedOn="{StaticResource DsCard}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <shapes:RoundRectangle CornerRadius="22" />
            </Setter.Value>
        </Setter>
    </Style>

    <!--  a row inside a card: one step lighter than the card it sits on  -->
    <Style x:Key="DsRow" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceRaisedLight}, Dark={StaticResource DarkSurfaceAlt}}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <shapes:RoundRectangle CornerRadius="12" />
            </Setter.Value>
        </Setter>
    </Style>

    <!--  bottom sheet: rounded at the top only, lifted off the content behind it  -->
    <Style x:Key="DsSheet" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource DarkSurface}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource DarkSurfaceAlt}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="20,12,20,18" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <shapes:RoundRectangle CornerRadius="28,28,0,0" />
            </Setter.Value>
        </Setter>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="Black" Opacity="0.4" Radius="30" Offset="0,-12" />
            </Setter.Value>
        </Setter>
    </Style>

    <!--  the grab handle every sheet in the design wears  -->
    <Style x:Key="DsSheetHandle" TargetType="BoxView">
        <Setter Property="WidthRequest" Value="40" />
        <Setter Property="HeightRequest" Value="4" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource DarkMuted}}" />
    </Style>

    <!-- ══════════════════════════════════════════════════════════
         FIELDS
         ══════════════════════════════════════════════════════════ -->

    <Style x:Key="DsField" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource DarkSurfaceAlt}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource DarkBorder}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="HeightRequest" Value="50" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <shapes:RoundRectangle CornerRadius="12" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DsEntry" TargetType="Entry">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource Gray100}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource TextDimLight}, Dark={StaticResource TextMuted}}" />
    </Style>

    <!--  the "Show"/"Hide" affordance inside a password field  -->
    <Style x:Key="DsFieldAction" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMuted}}" />
    </Style>

    <!-- ══════════════════════════════════════════════════════════
         CHIPS & BADGES
         Selected chips are teal-on-teal; unselected are outlined.
         ══════════════════════════════════════════════════════════ -->

    <Style x:Key="DsChip" TargetType="Border">
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HeightRequest" Value="32" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <shapes:RoundRectangle CornerRadius="16" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DsChipLabel" TargetType="Label">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource Gray300}}" />
    </Style>

    <!--  status pill: Active / Used / Expired. Colours come from TicketStatusColorConverter.  -->
    <Style x:Key="DsBadge" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="VerticalOptions" Value="Start" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <shapes:RoundRectangle CornerRadius="8" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DsBadgeLabel" TargetType="Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
    </Style>

    <!--  square operator monogram: ZET, HŽ, NB, FB …  -->
    <Style x:Key="DsMonogram" TargetType="Border">
        <Setter Property="WidthRequest" Value="42" />
        <Setter Property="HeightRequest" Value="42" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <shapes:RoundRectangle CornerRadius="11" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DsMonogramLabel" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="LineBreakMode" Value="NoWrap" />
    </Style>

    <!-- ══════════════════════════════════════════════════════════
         BUTTONS
         Teal is the money/commit action; violet is account creation;
         ghost is everything secondary.
         ══════════════════════════════════════════════════════════ -->

    <Style x:Key="DsPrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource TealContrast}}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="15.5" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="26" />
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="0.98" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource DarkSurfaceAlt}}" />
                            <Setter Property="TextColor" Value="{StaticResource TextDim}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="DsVioletButton" TargetType="Button" BasedOn="{StaticResource DsPrimaryButton}">
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="TextColor" Value="{StaticResource White}" />
    </Style>

    <Style x:Key="DsGhostButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource DarkMuted}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondary}}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="0.98" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!--  round map control (locate / layers) and other icon-sized taps  -->
    <Style x:Key="DsMapControl" TargetType="Border">
        <Setter Property="WidthRequest" Value="44" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource DarkSurface}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource DarkSurfaceAlt}}" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <shapes:RoundRectangle CornerRadius="14" />
            </Setter.Value>
        </Setter>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="Black" Opacity="0.3" Radius="12" Offset="0,4" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════
         BRUSHES
         ══════════════════════════════════════════════════════════ -->

    <LinearGradientBrush x:Key="DsHeroGradient" StartPoint="0,0" EndPoint="0.35,1">
        <GradientStop Offset="0" Color="{StaticResource HeroGradientStart}" />
        <GradientStop Offset="1" Color="{StaticResource HeroGradientEnd}" />
    </LinearGradientBrush>

</ResourceDictionary>
