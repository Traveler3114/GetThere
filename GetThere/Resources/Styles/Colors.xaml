<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--  Note: For Android please see also Platforms\Android\Resources\values\colors.xml  -->

    <Color x:Key="Primary">#512BD4</Color>
    <Color x:Key="PrimaryDark">#2C167A</Color>
    <Color x:Key="Accent">#009688</Color>
    <Color x:Key="Secondary">#C1B8F3</Color>
    <Color x:Key="Tertiary">#301985</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#F3F4F6</Color>
    <Color x:Key="Gray200">#E5E7EB</Color>
    <Color x:Key="Gray300">#D1D5DB</Color>
    <Color x:Key="Gray400">#9CA3AF</Color>
    <Color x:Key="Gray500">#6B7280</Color>
    <Color x:Key="Gray600">#4B5563</Color>
    <Color x:Key="Gray900">#111827</Color>
    <Color x:Key="Gray950">#020202</Color>
    <Color x:Key="OffWhite">#F8F9FA</Color>
    <Color x:Key="DarkBackground">#0F172A</Color>
    <Color x:Key="DarkSurface">#111827</Color>
    <Color x:Key="DarkSurfaceAlt">#1F2937</Color>
    <Color x:Key="DarkBorder">#374151</Color>
    <Color x:Key="DarkMuted">#334155</Color>
    <Color x:Key="DarkTextSecondary">#9CA3AF</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}" />
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}" />
    <SolidColorBrush x:Key="OffWhiteBrush" Color="{StaticResource OffWhite}" />

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}" />
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}" />
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}" />
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}" />
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}" />
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}" />
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}" />
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}" />
    <SolidColorBrush x:Key="DarkBackgroundBrush" Color="{StaticResource DarkBackground}" />
    <SolidColorBrush x:Key="DarkSurfaceBrush" Color="{StaticResource DarkSurface}" />
    <SolidColorBrush x:Key="DarkSurfaceAltBrush" Color="{StaticResource DarkSurfaceAlt}" />

    <!--
        Design-system tokens shared with both admin consoles (wwwroot/admin/style.css).
        Imported from the Claude Design project "GetThere UI"; the names mirror the CSS
        custom properties so a colour means the same thing on every surface.
    -->

    <!--  text ramp  -->
    <Color x:Key="TextPrimary">#E5E7EB</Color>
    <Color x:Key="TextSecondary">#CBD5E1</Color>
    <Color x:Key="TextMuted">#94A3B8</Color>
    <Color x:Key="TextDim">#64748B</Color>
    <Color x:Key="TextFaint">#475569</Color>

    <!--  teal accent: primary action + selected state  -->
    <Color x:Key="TealAccent">#2DD4BF</Color>
    <Color x:Key="TealText">#5EEAD4</Color>
    <Color x:Key="TealSurface">#134E4A</Color>
    <Color x:Key="TealContrast">#04231F</Color>

    <!--  violet accent: operator/brand chips  -->
    <Color x:Key="VioletText">#C4B5FD</Color>
    <Color x:Key="VioletSurface">#1C1740</Color>
    <Color x:Key="VioletBorder">#2E2464</Color>

    <!--  status  -->
    <Color x:Key="StatusOk">#10B981</Color>
    <Color x:Key="StatusOkStrong">#059669</Color>
    <Color x:Key="StatusOkSurface">#064E3B</Color>
    <Color x:Key="StatusWarn">#F59E0B</Color>
    <Color x:Key="StatusWarnText">#FBBF24</Color>
    <Color x:Key="StatusWarnSurface">#3B2A08</Color>
    <Color x:Key="StatusDanger">#EF4444</Color>
    <Color x:Key="StatusDangerText">#F87171</Color>
    <Color x:Key="StatusDangerSurface">#3B1214</Color>
    <Color x:Key="StatusNeutralSurface">#374151</Color>

    <!--  light-mode partners for the status surfaces above  -->
    <Color x:Key="StatusOkSurfaceLight">#E8F5E9</Color>
    <Color x:Key="StatusWarnSurfaceLight">#FEF3C7</Color>
    <Color x:Key="StatusDangerSurfaceLight">#FEE2E2</Color>
    <Color x:Key="StatusNeutralSurfaceLight">#E5E7EB</Color>
    <Color x:Key="TealSurfaceLight">#E0F2F1</Color>

    <!--  card gradient used by the wallet card and ticket header  -->
    <Color x:Key="CardGradientStart">#5F8FF5</Color>
    <Color x:Key="CardGradientMid">#5565EA</Color>
    <Color x:Key="CardGradientEnd">#5A24D9</Color>

    <SolidColorBrush x:Key="TealAccentBrush" Color="{StaticResource TealAccent}" />
    <SolidColorBrush x:Key="TealSurfaceBrush" Color="{StaticResource TealSurface}" />
    <SolidColorBrush x:Key="StatusOkBrush" Color="{StaticResource StatusOk}" />
    <SolidColorBrush x:Key="StatusWarnBrush" Color="{StaticResource StatusWarn}" />
    <SolidColorBrush x:Key="StatusDangerBrush" Color="{StaticResource StatusDanger}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}" />

    <LinearGradientBrush x:Key="CardGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{StaticResource CardGradientStart}" />
        <GradientStop Offset="0.55" Color="{StaticResource CardGradientMid}" />
        <GradientStop Offset="1" Color="{StaticResource CardGradientEnd}" />
    </LinearGradientBrush>
</ResourceDictionary>
