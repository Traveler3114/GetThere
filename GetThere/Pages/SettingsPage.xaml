<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="GetThere.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:GetThere.ViewModels"
    xmlns:components="clr-namespace:GetThere.Components"
    xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
    xmlns:helpers="clr-namespace:GetThere.Helpers"
    xmlns:localization="clr-namespace:GetThere.Localization"
    x:DataType="vm:SettingsViewModel"
    Title="{localization:Translate Settings_Title}"
    BackgroundColor="{AppThemeBinding Light={StaticResource OffWhite}, Dark={StaticResource DarkBackground}}"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <helpers:CountryBgConverter x:Key="CountryBgConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <components:AnimatedBackground Grid.RowSpan="2" />

        <Label Grid.Row="0" Margin="16,28,16,0" HorizontalTextAlignment="Center"
               Style="{StaticResource DsPageTitle}"
               Text="{localization:Translate Settings_Title}" />

        <ScrollView Grid.Row="1" Padding="16,16,16,100">
            <VerticalStackLayout Spacing="16" HorizontalOptions="Center" MaximumWidthRequest="600">

                <Border Padding="20" Style="{StaticResource DsCard}">
                    <VerticalStackLayout Spacing="12">
                        <Label FontSize="18" Style="{StaticResource DsCardTitle}"
                               Text="{localization:Translate Settings_Country}" />
                        <Label FontSize="14" Style="{StaticResource DsCardSubtitle}"
                               Text="{localization:Translate Settings_CountrySubtitle}" />

                        <ActivityIndicator HeightRequest="30" IsRunning="{Binding IsLoading}"
                                           IsVisible="{Binding IsLoading}"
                                           Color="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource TealText}}" />

                        <CollectionView ItemsSource="{Binding Countries}"
                                        SelectionMode="Single"
                                        SelectionChangedCommand="{Binding SelectCountryCommand}"
                                        HeightRequest="300">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:CountryItem">
                                    <Border Margin="0,0,0,8" Padding="16,12"
                                            BackgroundColor="{Binding IsSelected, Converter={StaticResource CountryBgConverter}, ConverterParameter=#134E4A}"
                                            StrokeThickness="0">
                                        <Border.StrokeShape><shapes:RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="{Binding Name}" FontSize="16"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource White}}"
                                                   VerticalOptions="Center" />
                                            <Label Grid.Column="1" Text="✓"
                                                   IsVisible="{Binding IsSelected}"
                                                   TextColor="{StaticResource StatusOk}" FontSize="18"
                                                   FontAttributes="Bold" VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Label Text="{Binding CurrentCountryText}" FontSize="13"
                               IsVisible="{Binding HasCurrentCountry}"
                               TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource TealText}}" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="20" Style="{StaticResource DsCard}">
                    <VerticalStackLayout Spacing="8">
                        <Label FontSize="18" Style="{StaticResource DsCardTitle}"
                               Text="{localization:Translate Settings_About}" />
                        <Label FontSize="14" Style="{StaticResource DsCardSubtitle}"
                               Text="{localization:Translate Settings_AboutText}" />
                        <Label FontSize="12" Style="{StaticResource DsCardSubtitle}"
                               Text="{localization:Translate Settings_MockDisclaimer}" />
                    </VerticalStackLayout>
                </Border>

                <Button Text="{localization:Translate Settings_Logout}"
                        Command="{Binding LogoutCommand}"
                        HorizontalOptions="Center" Margin="0,28,0,0"
                        Style="{StaticResource DsPrimaryButton}" WidthRequest="160" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
