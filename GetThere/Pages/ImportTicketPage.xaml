<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="GetThere.Pages.ImportTicketPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:GetThere.ViewModels"
    xmlns:helpers="clr-namespace:GetThere.Helpers"
    xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
    xmlns:localization="clr-namespace:GetThere.Localization"
    x:DataType="vm:ImportTicketViewModel"
    Title="Import Ticket"
    BackgroundColor="{AppThemeBinding Light={StaticResource SurfacePageLight}, Dark={StaticResource DarkBackground}}"
    Shell.NavBarIsVisible="True">

    <ContentPage.Resources>
        <helpers:InverseBoolConverter x:Key="Invert" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="24,20" Spacing="16" MaximumWidthRequest="500" HorizontalOptions="Center">
            <Label FontSize="24" Style="{StaticResource DsPageTitle}" Text="Add ticket" />
            <Label Style="{StaticResource DsPageSubtitle}" Text="Fill in the details of your ticket."
                   IsVisible="{Binding HasDraft, Converter={StaticResource Invert}}" />

            <!--
                Shown when the ticket arrived from a file or pasted text. Extraction is best-effort,
                so this frames the prefilled values as something to check rather than as fact — the
                fields below stay fully editable whatever was read.
            -->
            <Border Style="{StaticResource DsCard}" IsVisible="{Binding HasDraft}">
                <VerticalStackLayout Spacing="6">
                    <Label Style="{StaticResource DsCardSubtitle}" Text="{Binding DraftSummary}" />
                    <Label Style="{StaticResource DsMetaCaption}" Text="{Binding WarningText}"
                           IsVisible="{Binding HasWarning}" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="6">
                <Label Text="Ticket Name *" Style="{StaticResource DsFieldLabel}" />
                <Border Style="{StaticResource DsField}">
                    <Entry Text="{Binding TicketName}" Placeholder="e.g. Zagreb–Rijeka Return" Style="{StaticResource DsEntry}" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label Text="Route / Description" Style="{StaticResource DsFieldLabel}" />
                <Border Style="{StaticResource DsField}">
                    <Entry Text="{Binding RouteDescription}" Placeholder="e.g. Zagreb Gl. Kolodvor → Rijeka" Style="{StaticResource DsEntry}" />
                </Border>
            </VerticalStackLayout>

            <!--
                Structured endpoints, separate from the free-text route above. Journey grouping
                chains on these, which a prose description cannot support, and a wallet pass always
                carries them.
            -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <VerticalStackLayout Spacing="6">
                    <Label Text="From (optional)" Style="{StaticResource DsFieldLabel}" />
                    <Border Style="{StaticResource DsField}">
                        <Entry Text="{Binding OriginName}" Placeholder="e.g. Zagreb Gl. Kol." Style="{StaticResource DsEntry}" />
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="6">
                    <Label Text="To (optional)" Style="{StaticResource DsFieldLabel}" />
                    <Border Style="{StaticResource DsField}">
                        <Entry Text="{Binding DestinationName}" Placeholder="e.g. Rijeka" Style="{StaticResource DsEntry}" />
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Valid From" Style="{StaticResource DsFieldLabel}" />
                    <Border Style="{StaticResource DsField}">
                        <DatePicker Date="{Binding ValidFrom}" FontSize="14" VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="6">
                    <Label Text="Valid To" Style="{StaticResource DsFieldLabel}" />
                    <Border Style="{StaticResource DsField}">
                        <DatePicker Date="{Binding ValidTo}" FontSize="14" VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout Spacing="6">
                <Label Text="Price (optional)" Style="{StaticResource DsFieldLabel}" />
                <Border Style="{StaticResource DsField}">
                    <Entry Text="{Binding PriceText}" Placeholder="e.g. 12.50" Keyboard="Numeric" Style="{StaticResource DsEntry}" />
                </Border>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Currency" Style="{StaticResource DsFieldLabel}" />
                    <Border Style="{StaticResource DsField}">
                        <Picker ItemsSource="{Binding Currencies}" SelectedItem="{Binding SelectedCurrency}"
                                FontSize="14" BackgroundColor="Transparent" VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="6">
                    <Label Text="Operator (optional)" Style="{StaticResource DsFieldLabel}" />
                    <Border Style="{StaticResource DsField}">
                        <Entry Text="{Binding OperatorName}" Placeholder="e.g. HŽ Putnički Prijevoz" Style="{StaticResource DsEntry}" />
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <Label Text="{Binding ErrorText}" IsVisible="{Binding HasError}" Style="{StaticResource DsErrorLabel}" />
            <Button Text="{localization:Translate App_Save}" Command="{Binding SaveCommand}"
                    Style="{StaticResource DsVioletButton}" Margin="0,10,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
