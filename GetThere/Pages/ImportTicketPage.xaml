<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="GetThere.Pages.ImportTicketPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:GetThere.ViewModels"
    xmlns:components="clr-namespace:GetThere.Components"
    xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
    x:DataType="vm:ImportTicketViewModel"
    Title="Import Ticket"
    BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#0F172A}"
    Shell.NavBarIsVisible="True">

    <ScrollView>
        <VerticalStackLayout Padding="24,20" Spacing="16" MaximumWidthRequest="500" HorizontalOptions="Center">
            <Label Text="Add Ticket Manually" FontSize="24" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=Black, Dark=White}" />
            <Label Text="Fill in the details of your ticket." FontSize="14"
                   TextColor="{AppThemeBinding Light=#64748B, Dark=#9CA3AF}" />

            <VerticalStackLayout Spacing="6">
                <Label Text="Ticket Name *" FontSize="13" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                <Border Padding="12,0" BackgroundColor="{AppThemeBinding Light=White, Dark=#1F2937}"
                        StrokeThickness="1" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#374151}">
                    <Border.StrokeShape><shapes:RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                    <Entry Text="{Binding TicketName}" Placeholder="e.g. Zagreb–Rijeka Return"
                           FontSize="16" BackgroundColor="Transparent" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label Text="Route / Description" FontSize="13" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                <Border Padding="12,0" BackgroundColor="{AppThemeBinding Light=White, Dark=#1F2937}"
                        StrokeThickness="1" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#374151}">
                    <Border.StrokeShape><shapes:RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                    <Entry Text="{Binding RouteDescription}" Placeholder="e.g. Zagreb Gl. Kolodvor → Rijeka"
                           FontSize="16" BackgroundColor="Transparent" />
                </Border>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Valid From" FontSize="13" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                    <DatePicker Date="{Binding ValidFrom}" FontSize="16" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="6">
                    <Label Text="Valid To" FontSize="13" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                    <DatePicker Date="{Binding ValidTo}" FontSize="16" />
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout Spacing="6">
                <Label Text="Price (optional)" FontSize="13" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                <Border Padding="12,0" BackgroundColor="{AppThemeBinding Light=White, Dark=#1F2937}"
                        StrokeThickness="1" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#374151}">
                    <Border.StrokeShape><shapes:RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                    <Entry Text="{Binding PriceText}" Placeholder="e.g. 12.50"
                           Keyboard="Numeric" FontSize="16" BackgroundColor="Transparent" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label Text="Operator (optional)" FontSize="13" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                <Border Padding="12,0" BackgroundColor="{AppThemeBinding Light=White, Dark=#1F2937}"
                        StrokeThickness="1" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#374151}">
                    <Border.StrokeShape><shapes:RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                    <Entry Text="{Binding OperatorName}" Placeholder="e.g. HŽ Putnički Prijevoz"
                           FontSize="16" BackgroundColor="Transparent" />
                </Border>
            </VerticalStackLayout>

            <Label Text="{Binding ErrorText}" IsVisible="{Binding HasError}"
                   TextColor="#DC2626" FontSize="13" />

            <Button Text="Save Ticket" Command="{Binding SaveCommand}"
                    BackgroundColor="#512BD4" TextColor="White"
                    CornerRadius="24" HeightRequest="50" FontAttributes="Bold"
                    Margin="0,10,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
