<?xml version="1.0" encoding="utf-8" ?>
<!--
    Frames 3i (iPhone · Login) and 3k (Windows · Login) of "GetThere App.dc.html".

    Both frames are the same two pieces — a gradient brand panel and the sign-in form — arranged
    differently: stacked with the form riding up over the gradient on phones, side by side on
    desktop. The code-behind moves the two containers between rows and columns on resize rather
    than the markup carrying two copies of the form.
-->
<ContentPage
    x:Class="GetThere.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:GetThere.Components"
    xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
    xmlns:localization="clr-namespace:GetThere.Localization"
    xmlns:vm="clr-namespace:GetThere.ViewModels"
    xmlns:helpers="clr-namespace:GetThere.Helpers"
    x:DataType="vm:LoginViewModel"
    Title="{localization:Translate Login_Title}"
    BackgroundColor="{AppThemeBinding Light={StaticResource OffWhite}, Dark={StaticResource DarkBackground}}"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <helpers:InverseBoolConverter x:Key="InverseBoolConverter" />
    </ContentPage.Resources>

    <Grid>
        <components:AnimatedBackground />

        <Grid x:Name="LoginRoot" ColumnDefinitions="*" RowDefinitions="Auto,*">

            <!--  ── BRAND PANEL ──  -->
            <Border
                x:Name="BrandPanel"
                Grid.Row="0"
                Grid.Column="0"
                Background="{StaticResource DsHeroGradient}"
                HeightRequest="320"
                StrokeThickness="0"
                VerticalOptions="Fill">
                <Border.Shadow>
                    <Shadow
                        Brush="Black"
                        Opacity="0.3"
                        Radius="10"
                        Offset="0,5" />
                </Border.Shadow>

                <VerticalStackLayout
                    x:Name="BrandStack"
                    Margin="0,30,0,0"
                    Spacing="15"
                    VerticalOptions="Start">
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                        <BoxView
                            CornerRadius="9"
                            HeightRequest="18"
                            VerticalOptions="Center"
                            WidthRequest="18"
                            Color="{StaticResource StatusOk}" />
                        <Label
                            FontAttributes="Bold"
                            FontSize="22"
                            Text="GetThere"
                            TextColor="White"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <Border
                        BackgroundColor="{AppThemeBinding Light=#EEF2FF, Dark={StaticResource PrimaryDark}}"
                        HeightRequest="160"
                        HorizontalOptions="Center"
                        StrokeThickness="0"
                        WidthRequest="160">
                        <Border.StrokeShape>
                            <shapes:RoundRectangle CornerRadius="80" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow
                                Brush="Black"
                                Opacity="0.2"
                                Radius="10"
                                Offset="3,3" />
                        </Border.Shadow>
                        <Image
                            x:Name="LogoImage"
                            Margin="10"
                            Aspect="AspectFit"
                            Source="logo.svg" />
                    </Border>

                    <!--  desktop-only strapline (frame 3k)  -->
                    <Label
                        x:Name="BrandTagline"
                        Margin="0,10,0,0"
                        FontSize="14"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        IsVisible="False"
                        MaximumWidthRequest="320"
                        Opacity="0.75"
                        Text="{localization:Translate Login_Tagline}"
                        TextColor="White" />
                </VerticalStackLayout>
            </Border>

            <!--  ── FORM ──  -->
            <ScrollView
                x:Name="FormHost"
                Grid.Row="1"
                Grid.Column="0"
                Margin="0,-60,0,0"
                VerticalOptions="Fill">
                <Border
                    x:Name="LoginCard"
                    Margin="1"
                    Padding="30,15,30,30"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource DarkSurface}}"
                    HorizontalOptions="Center"
                    StrokeThickness="0"
                    VerticalOptions="Start">
                    <Border.Shadow>
                        <Shadow
                            Brush="Black"
                            Opacity="0.15"
                            Radius="15"
                            Offset="0,10" />
                    </Border.Shadow>
                    <Border.StrokeShape>
                        <shapes:RoundRectangle CornerRadius="22,22,0,0" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="16">
                        <BoxView
                            x:Name="SheetHandle"
                            Margin="0,0,0,15"
                            Style="{StaticResource DsSheetHandle}" />

                        <VerticalStackLayout Spacing="8">
                            <Label Style="{StaticResource DsFieldLabel}" Text="{localization:Translate Login_EmailLabel}" />
                            <Border Style="{StaticResource DsField}">
                                <Entry
                                    Keyboard="Email"
                                    Placeholder="{localization:Translate Login_EmailPlaceholder}"
                                    Style="{StaticResource DsEntry}"
                                    Text="{Binding Email}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label Style="{StaticResource DsFieldLabel}" Text="{localization:Translate Login_PasswordLabel}" />
                            <Border Style="{StaticResource DsField}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Entry
                                        IsPassword="{Binding IsPasswordVisible, Converter={StaticResource InverseBoolConverter}}"
                                        Placeholder="{localization:Translate Login_PasswordPlaceholder}"
                                        Style="{StaticResource DsEntry}"
                                        Text="{Binding Password}" />
                                    <Label
                                        Grid.Column="1"
                                        Style="{StaticResource DsFieldAction}"
                                        Text="{Binding PasswordToggleText}">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding TogglePasswordCommand}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <Label
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            IsVisible="{Binding HasError}"
                            Style="{StaticResource DsErrorLabel}"
                            Text="{Binding ErrorText}" />

                        <HorizontalStackLayout
                            Padding="0,5"
                            Spacing="8"
                            VerticalOptions="Center">
                            <CheckBox
                                Color="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource TealText}}"
                                IsChecked="{Binding RememberMe}"
                                VerticalOptions="Center" />
                            <Label
                                FontSize="13.5"
                                Text="{localization:Translate Login_RememberMe}"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimary}}"
                                VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleRememberMeCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>

                        <Grid Margin="0,4,0,0">
                            <Button
                                Command="{Binding LoginCommand}"
                                IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                                Style="{StaticResource DsPrimaryButton}"
                                Text="{localization:Translate Login_Button}">
                                <Button.Shadow>
                                    <Shadow
                                        Brush="{StaticResource AccentBrush}"
                                        Opacity="0.35"
                                        Radius="14"
                                        Offset="0,6" />
                                </Button.Shadow>
                            </Button>

                            <!--  Busy state sits on top of the button, as in the design's signing-in frame.  -->
                            <Border
                                BackgroundColor="{AppThemeBinding Light={StaticResource TealSurfaceLight}, Dark={StaticResource TealSurface}}"
                                HeightRequest="52"
                                IsVisible="{Binding IsLoading}"
                                StrokeThickness="0">
                                <Border.StrokeShape>
                                    <shapes:RoundRectangle CornerRadius="26" />
                                </Border.StrokeShape>
                                <HorizontalStackLayout
                                    HorizontalOptions="Center"
                                    Spacing="10"
                                    VerticalOptions="Center">
                                    <ActivityIndicator
                                        HeightRequest="18"
                                        IsRunning="{Binding IsLoading}"
                                        WidthRequest="18"
                                        Color="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource TealText}}" />
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="15.5"
                                        Text="{localization:Translate Login_SigningIn}"
                                        TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource TealText}}"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>

                        <Label
                            Margin="0,5"
                            HorizontalOptions="Center"
                            Style="{StaticResource DsLinkLabel}"
                            Text="{localization:Translate Login_CreateAccount}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToRegisterCommand}" />
                            </Label.GestureRecognizers>
                        </Label>

                        <Label
                            Margin="0,0,0,5"
                            HorizontalOptions="Center"
                            Style="{StaticResource DsPageSubtitle}"
                            Text="{localization:Translate Login_ContinueAsGuest}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ContinueAsGuestCommand}" />
                            </Label.GestureRecognizers>
                        </Label>

                        <HorizontalStackLayout
                            Margin="0,15,0,0"
                            HorizontalOptions="Center"
                            Spacing="16">
                            <Border
                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceRaisedLight}, Dark={StaticResource DarkMuted}}"
                                HeightRequest="44"
                                StrokeThickness="0"
                                WidthRequest="44">
                                <Border.StrokeShape>
                                    <shapes:RoundRectangle CornerRadius="22" />
                                </Border.StrokeShape>
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="18"
                                    HorizontalOptions="Center"
                                    Text="G"
                                    TextColor="#93C5FD"
                                    VerticalOptions="Center" />
                            </Border>
                            <Border
                                BackgroundColor="{AppThemeBinding Light={StaticResource DarkSurfaceAlt}, Dark={StaticResource TextFaint}}"
                                HeightRequest="44"
                                StrokeThickness="0"
                                WidthRequest="44">
                                <Border.StrokeShape>
                                    <shapes:RoundRectangle CornerRadius="22" />
                                </Border.StrokeShape>
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    HorizontalOptions="Center"
                                    Text=""
                                    TextColor="White"
                                    VerticalOptions="Center" />
                            </Border>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
