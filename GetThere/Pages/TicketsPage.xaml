<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="GetThere.Pages.TicketsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:GetThere.ViewModels"
    xmlns:helpers="clr-namespace:GetThere.Helpers"
    xmlns:components="clr-namespace:GetThere.Components"
    xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
    x:DataType="vm:TicketsViewModel"
    Title="Tickets"
    BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#0F172A}"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <helpers:InverseBoolConverter x:Key="InverseBoolConverter" />
    </ContentPage.Resources>

    <Grid>
        <components:AnimatedBackground />

        <Grid RowDefinitions="Auto,Auto,*" Padding="20,32,20,96">
            <VerticalStackLayout Grid.Row="0" Spacing="4">
                <Label Text="My Tickets" FontSize="32" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                <Label Text="Your imported transit tickets" FontSize="15"
                       TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
            </VerticalStackLayout>

            <!-- Filter Chips -->
            <HorizontalStackLayout Grid.Row="1" Spacing="8" Margin="0,16,0,0">
                <Border StrokeThickness="1" Stroke="{AppThemeBinding Light=#D1D5DB, Dark=#4B5563}"
                        BackgroundColor="Transparent">
                    <Border.StrokeShape><shapes:RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                    <Label Text="All" TextColor="{AppThemeBinding Light=#374151, Dark=#D1D5DB}" FontSize="13" Padding="14,6" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding FilterCommand}" CommandParameter="" />
                    </Border.GestureRecognizers>
                </Border>
                <Border StrokeThickness="1" Stroke="{AppThemeBinding Light=#D1D5DB, Dark=#4B5563}"
                        BackgroundColor="Transparent">
                    <Border.StrokeShape><shapes:RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                    <Label Text="Active" TextColor="{AppThemeBinding Light=#374151, Dark=#D1D5DB}" FontSize="13" Padding="14,6" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding FilterCommand}" CommandParameter="Active" />
                    </Border.GestureRecognizers>
                </Border>
                <Border StrokeThickness="1" Stroke="{AppThemeBinding Light=#D1D5DB, Dark=#4B5563}"
                        BackgroundColor="Transparent">
                    <Border.StrokeShape><shapes:RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                    <Label Text="Used" TextColor="{AppThemeBinding Light=#374151, Dark=#D1D5DB}" FontSize="13" Padding="14,6" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding FilterCommand}" CommandParameter="Used" />
                    </Border.GestureRecognizers>
                </Border>
                <Border StrokeThickness="1" Stroke="{AppThemeBinding Light=#D1D5DB, Dark=#4B5563}"
                        BackgroundColor="Transparent">
                    <Border.StrokeShape><shapes:RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                    <Label Text="Expired" TextColor="{AppThemeBinding Light=#374151, Dark=#D1D5DB}" FontSize="13" Padding="14,6" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding FilterCommand}" CommandParameter="Expired" />
                    </Border.GestureRecognizers>
                </Border>
            </HorizontalStackLayout>

            <CollectionView Grid.Row="2" ItemsSource="{Binding ImportedTickets}" Margin="0,12,0,0">
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                        <Label Text="No tickets yet" FontSize="20" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#9CA3AF, Dark=#6B7280}" HorizontalOptions="Center" />
                        <Label Text="Import your first ticket using the + button below" FontSize="14"
                               TextColor="{AppThemeBinding Light=#D1D5DB, Dark=#4B5563}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,6" Padding="16" BackgroundColor="{AppThemeBinding Light=White, Dark=#1F2937}"
                                StrokeThickness="0">
                            <Border.StrokeShape><shapes:RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="4">
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding TicketName}" FontSize="16" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                                <Border Grid.Row="0" Grid.Column="1" StrokeThickness="0" Padding="8,2"
                                        BackgroundColor="{AppThemeBinding Light=#E8F5E9, Dark=#064E3B}">
                                    <Border.StrokeShape><shapes:RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                    <Label Text="{Binding Status}" FontSize="11" TextColor="#10B981" />
                                </Border>
                                <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding RouteDescription}"
                                       FontSize="13" TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                                       LineBreakMode="TailTruncation" />
                                <HorizontalStackLayout Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Spacing="12">
                                    <Label Text="{Binding ValidFrom, StringFormat='{0:dd.MM.yyyy}'}" FontSize="12"
                                           TextColor="{AppThemeBinding Light=#9CA3AF, Dark=#6B7280}" />
                                    <Label Text="→" FontSize="12" TextColor="{AppThemeBinding Light=#9CA3AF, Dark=#6B7280}" />
                                    <Label Text="{Binding ValidTo, StringFormat='{0:dd.MM.yyyy}'}" FontSize="12"
                                           TextColor="{AppThemeBinding Light=#9CA3AF, Dark=#6B7280}" />
                                    <Label Text="{Binding Price, StringFormat='{0:N2} EUR'}" FontSize="13" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                                </HorizontalStackLayout>
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TicketsViewModel}}, Path=CancelTicketCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <Button Text="+" Command="{Binding ImportTicketCommand}"
                BackgroundColor="#512BD4" TextColor="White"
                FontSize="28" FontAttributes="Bold"
                CornerRadius="32" WidthRequest="64" HeightRequest="64"
                HorizontalOptions="End" VerticalOptions="End" Margin="0,0,24,120" />

        <Grid IsVisible="{Binding IsAuthenticated, Converter={StaticResource InverseBoolConverter}}"
              BackgroundColor="{AppThemeBinding Light=#80FFFFFF, Dark=#80000000}">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12" Padding="32">
                <Label Text="Sign in to manage your tickets" FontSize="18" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=Black, Dark=White}" HorizontalOptions="Center" />
                <Button Text="Sign In" Command="{Binding GoToLoginCommand}"
                        BackgroundColor="#512BD4" TextColor="White"
                        CornerRadius="24" HeightRequest="48" WidthRequest="200" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
