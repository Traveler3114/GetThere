<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="GetThere.Pages.TicketsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:GetThere.ViewModels"
    xmlns:helpers="clr-namespace:GetThere.Helpers"
    xmlns:components="clr-namespace:GetThere.Components"
    xmlns:localization="clr-namespace:GetThere.Localization"
    xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
    x:DataType="vm:TicketsViewModel"
    Title="My Tickets"
    BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#0F172A}"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <helpers:InverseBoolConverter x:Key="InverseBoolConverter" />
    </ContentPage.Resources>

    <Grid>
        <components:AnimatedBackground />

        <Grid RowDefinitions="Auto, *, Auto" Padding="20,50,20,0">
            <!-- HEADER -->
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,10">
                <VerticalStackLayout>
                    <Label Text="My Tickets" FontSize="26" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                    <Label Text="{Binding FilterLabel, StringFormat='Showing: {0}'}"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light=#64748B, Dark=#9CA3AF}" />
                </VerticalStackLayout>
                <Border Grid.Column="1" WidthRequest="44" HeightRequest="44"
                        BackgroundColor="#512BD4" StrokeThickness="0"
                        VerticalOptions="Center">
                    <Border.StrokeShape><shapes:RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                    <Label Text="+" FontSize="28" TextColor="White"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ImportTicketCommand}" />
                    </Border.GestureRecognizers>
                </Border>
            </Grid>

            <!-- FILTER CHIPS -->
            <ScrollView Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10"
                        IsVisible="{Binding IsGuest, Converter={StaticResource InverseBoolConverter}}">
                <HorizontalStackLayout Spacing="10">
                    <Border Padding="12,6" StrokeThickness="1" Stroke="#512BD4"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1F2937}">
                        <Border.StrokeShape><shapes:RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                        <Label Text="All" FontSize="13" TextColor="#512BD4" VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SetFilterCommand}" CommandParameter="" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Border>
                    <Border Padding="12,6" StrokeThickness="0"
                            BackgroundColor="#05966920">
                        <Border.StrokeShape><shapes:RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                        <Label Text="Active" FontSize="13" TextColor="#059669" VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SetFilterCommand}" CommandParameter="Active" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Border>
                    <Border Padding="12,6" StrokeThickness="0"
                            BackgroundColor="#6B728020">
                        <Border.StrokeShape><shapes:RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                        <Label Text="Used" FontSize="13" TextColor="#6B7280" VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SetFilterCommand}" CommandParameter="Used" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Border>
                    <Border Padding="12,6" StrokeThickness="0"
                            BackgroundColor="#DC262620">
                        <Border.StrokeShape><shapes:RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                        <Label Text="Expired" FontSize="13" TextColor="#DC2626" VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SetFilterCommand}" CommandParameter="Expired" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Border>
                </HorizontalStackLayout>
            </ScrollView>

            <!-- TICKET LIST -->
            <CollectionView Grid.Row="2" ItemsSource="{Binding ImportedTickets}"
                            IsVisible="{Binding HasImportedTickets}"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="x:Object">
                        <Border Margin="0,0,0,10" Padding="16"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#111827}"
                                StrokeThickness="0">
                            <Border.StrokeShape><shapes:RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                            <Border.Shadow><Shadow Brush="Black" Opacity="0.06" Radius="8" Offset="0,4" /></Border.Shadow>
                            <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto" ColumnSpacing="12" RowSpacing="4">
                                <Label Grid.Row="0" Grid.Column="0"
                                       Text="{Binding TicketName}" FontSize="16" FontAttributes="Bold"
                                       LineBreakMode="TailTruncation"
                                       TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                                <Border Grid.Row="0" Grid.Column="1" Padding="8,2"
                                        BackgroundColor="#512BD420" StrokeThickness="0"
                                        VerticalOptions="Start">
                                    <Border.StrokeShape><shapes:RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                    <Label Text="{Binding Source}" FontSize="11" TextColor="#512BD4"
                                           FontAttributes="Bold" />
                                </Border>
                                <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                       Text="{Binding RouteDescription}" FontSize="13"
                                       TextColor="{AppThemeBinding Light=#64748B, Dark=#9CA3AF}"
                                       LineBreakMode="TailTruncation" />
                                <HorizontalStackLayout Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Spacing="16">
                                    <Label Text="{Binding ValidFrom, StringFormat='{0:dd MMM yyyy}'}" FontSize="12"
                                           TextColor="{AppThemeBinding Light=Gray, Dark=#9CA3AF}" />
                                    <Label Text="{Binding Price, StringFormat='€{0:N2}'}" FontSize="12" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#059669, Dark=#34D399}" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12" Padding="40">
                        <Label Text="No tickets yet" FontSize="20" FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                        <Label Text="Import your first ticket to get started."
                               FontSize="14" HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#64748B, Dark=#9CA3AF}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>

            <!-- LOADING -->
            <ActivityIndicator Grid.Row="2" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               Color="#512BD4" VerticalOptions="Center" />
        </Grid>

        <!-- GUEST OVERLAY -->
        <Grid IsVisible="{Binding IsGuest}"
              BackgroundColor="{AppThemeBinding Light=#E6FFFFFF, Dark=#E6000000}"
              InputTransparent="False" ZIndex="100">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="20" Padding="40">
                <Label Text="Sign in to view your tickets" FontSize="22" FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                <Label Text="Log in or create an account to import and manage your tickets."
                       FontSize="14" HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light=#666, Dark=#AAA}" />
                <Button Text="Log In / Register" BackgroundColor="#512BD4" TextColor="White"
                        CornerRadius="24" HeightRequest="50" FontAttributes="Bold"
                        Command="{Binding GoToLoginCommand}" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
