<?xml version="1.0" encoding="utf-8" ?>
<!--  Frame 3j (iPhone · Registration) of "GetThere App.dc.html".  -->
<ContentPage
    x:Class="GetThere.Pages.RegistrationPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:GetThere.Components"
    xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
    xmlns:localization="clr-namespace:GetThere.Localization"
    xmlns:vm="clr-namespace:GetThere.ViewModels"
    xmlns:helpers="clr-namespace:GetThere.Helpers"
    x:DataType="vm:RegistrationViewModel"
    Title="{localization:Translate Register_Title}"
    BackgroundColor="{AppThemeBinding Light={StaticResource OffWhite}, Dark={StaticResource DarkBackground}}"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <helpers:InverseBoolConverter x:Key="InverseBoolConverter" />
    </ContentPage.Resources>

    <Grid>
        <components:AnimatedBackground />

        <ScrollView>
            <Border
                x:Name="RegistrationCard"
                Margin="24,80,24,24"
                Padding="30,26"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource DarkSurface}}"
                HorizontalOptions="Center"
                MaximumWidthRequest="400"
                StrokeThickness="0"
                VerticalOptions="Start">
                <Border.Shadow>
                    <Shadow
                        Brush="Black"
                        Opacity="0.35"
                        Radius="26"
                        Offset="0,10" />
                </Border.Shadow>
                <Border.StrokeShape>
                    <shapes:RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>

                <VerticalStackLayout MaximumWidthRequest="400" Spacing="14">
                    <Label
                        FontSize="24"
                        HorizontalOptions="Center"
                        Style="{StaticResource DsPageTitle}"
                        Text="{localization:Translate Register_Title}" />
                    <Label
                        Margin="0,-8,0,0"
                        FontSize="13"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource DsPageSubtitle}"
                        Text="{localization:Translate Register_Subtitle}" />

                    <VerticalStackLayout Spacing="6">
                        <Label Style="{StaticResource DsFieldLabel}" Text="{localization:Translate Register_FullNameLabel}" />
                        <Border Style="{StaticResource DsField}">
                            <Entry
                                Placeholder="{localization:Translate Register_FullNamePlaceholder}"
                                Style="{StaticResource DsEntry}"
                                Text="{Binding FullName}" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Style="{StaticResource DsFieldLabel}" Text="{localization:Translate Register_EmailLabel}" />
                        <Border Style="{StaticResource DsField}">
                            <Entry
                                Keyboard="Email"
                                Placeholder="{localization:Translate Register_EmailPlaceholder}"
                                Style="{StaticResource DsEntry}"
                                Text="{Binding Email}" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Style="{StaticResource DsFieldLabel}" Text="{localization:Translate Register_PasswordLabel}" />
                        <Border Style="{StaticResource DsField}">
                            <Grid ColumnDefinitions="*,Auto">
                                <Entry
                                    IsPassword="{Binding IsPasswordVisible, Converter={StaticResource InverseBoolConverter}}"
                                    Placeholder="{localization:Translate Register_PasswordPlaceholder}"
                                    Style="{StaticResource DsEntry}"
                                    Text="{Binding Password}" />
                                <Label
                                    Grid.Column="1"
                                    Style="{StaticResource DsFieldAction}"
                                    Text="{Binding PasswordToggleText}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding TogglePasswordCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Style="{StaticResource DsFieldLabel}" Text="{localization:Translate Register_ConfirmPasswordLabel}" />
                        <Border Style="{StaticResource DsField}">
                            <Grid ColumnDefinitions="*,Auto">
                                <Entry
                                    IsPassword="{Binding IsConfirmPasswordVisible, Converter={StaticResource InverseBoolConverter}}"
                                    Placeholder="{localization:Translate Register_ConfirmPasswordPlaceholder}"
                                    Style="{StaticResource DsEntry}"
                                    Text="{Binding ConfirmPassword}" />
                                <Label
                                    Grid.Column="1"
                                    Style="{StaticResource DsFieldAction}"
                                    Text="{Binding ConfirmToggleText}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ToggleConfirmCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <Label
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        IsVisible="{Binding HasError}"
                        Style="{StaticResource DsErrorLabel}"
                        Text="{Binding ErrorText}" />

                    <Button
                        Margin="0,6,0,0"
                        Command="{Binding RegisterCommand}"
                        Style="{StaticResource DsVioletButton}"
                        Text="{localization:Translate Register_Button}">
                        <Button.Shadow>
                            <Shadow
                                Brush="{StaticResource PrimaryBrush}"
                                Opacity="0.35"
                                Radius="14"
                                Offset="0,6" />
                        </Button.Shadow>
                    </Button>

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                        <Label
                            FontSize="13.5"
                            Style="{StaticResource DsPageSubtitle}"
                            Text="{localization:Translate Register_AlreadyHaveAccount}"
                            VerticalOptions="Center" />
                        <Label
                            FontSize="13.5"
                            Style="{StaticResource DsLinkLabel}"
                            Text="{localization:Translate Register_SignIn}"
                            VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToLoginCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </ScrollView>
    </Grid>
</ContentPage>
