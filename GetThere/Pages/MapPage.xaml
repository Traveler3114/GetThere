<?xml version="1.0" encoding="utf-8" ?>
<!--
    Frame 3a of "GetThere App.dc.html".

    The whole screen is the map page, served by TransitInfoAPI and shown in a WebView. The search
    field, transport-mode chips and map controls used to be drawn natively over it and driven
    through EvaluateJavaScriptAsync; they now live in the page itself, so every control has one
    implementation instead of a XAML half and a JavaScript half that had to be kept in step by hand.
    Station details were already the page's own.

    The one remaining bridge is one-way, WebView→native: the page's "Get tickets" button navigates
    to the gtapp://journey scheme, which the code-behind cancels and reads into JourneyHandoff so the
    app can buy the itinerary through GetThereAPI. Nothing is ever injected into the page.
-->
<ContentPage
    x:Class="GetThere.Pages.MapPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:GetThere.ViewModels"
    xmlns:components="clr-namespace:GetThere.Components"
    x:DataType="vm:MapViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource SurfacePageLight}, Dark={StaticResource MapCanvas}}"
    Shell.NavBarIsVisible="False">

    <Grid>
        <components:AnimatedBackground />

        <WebView x:Name="MapWebView" Source="{Binding MapUrl}" />
    </Grid>
</ContentPage>
