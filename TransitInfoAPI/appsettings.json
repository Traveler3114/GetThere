{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=TransitInfoDB;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "FeedPolling": {
    "IntervalMinutes": 60,
    "MaxConsecutiveFailuresBeforeDeactivate": 10
  },
  "RealtimePolling": {
    "IntervalSeconds": 30,
    "MaxConsecutiveFailuresBeforeDeactivate": 10
  },
  "Reconciliation": {
    "AutoMergeNameThreshold": 0.90,
    "AutoMergeDistanceMeters": 100,
    "ManualReviewNameThreshold": 0.70,
    "ManualReviewDistanceMeters": 300
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5000"
      },
      "Https": {
        "Url": "https://0.0.0.0:5001"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "TransitInfoAPI": "Information",
      "Microsoft.Hosting.Lifetime": "Warning",
      "System.Net.Http": "None"
    }
  },
  "Jwt": {
    "Key": "CHANGE-ME",
    "Issuer": "TransitInfoAPI",
    "Audience": "TransitInfoApp",
    "ExpiryMinutes": 15,
    "RefreshTokenDays": 1,
    "RefreshTokenDaysRememberMe": 30
  },
  "MobilityPolling": {
    "IntervalSeconds": 120,
    "MaxConsecutiveFailuresBeforeDeactivate": 10,
    "InitialDelaySeconds": 15
  },
  "PlaceMatching": {
    "MaxDistanceMeters": 50000,
    "DefaultCountryIsoCode": "HR"
  },
  "FeedImport": {
    "BulkCommandTimeoutSeconds": 600
  },
  "Routing": {
    "Timezone": "Europe/Zagreb",
    "Scope": {
      "MinLat": 45.60,
      "MinLon": 15.70,
      "MaxLat": 45.95,
      "MaxLon": 16.25
    },
    "OsmExtract": {
      "Path": null,
      "BoundingBox": {
        "MinLat": 45.60,
        "MinLon": 15.70,
        "MaxLat": 45.95,
        "MaxLon": 16.25
      },
      "RefreshIntervalHours": 24,
      "Regions": [
        {
          "Name": "croatia",
          "GeofabrikPath": "europe/croatia"
        }
      ]
    },
    "Otp": {
      "Endpoint": null
    }
  },
  "Geocoding": {
    "AzureMapsKey": null,
    "BaseUrl": "https://atlas.microsoft.com",
    "CountrySet": "HR",
    "Limit": 5,
    "Viewport": {
      "MinLat": 45.60,
      "MinLon": 15.70,
      "MaxLat": 45.95,
      "MaxLon": 16.25
    }
  },
  "AllowedHosts": "*"
}
