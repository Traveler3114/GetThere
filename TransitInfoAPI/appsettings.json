{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=TransitInfoDB;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "FeedPolling": {
    "IntervalMinutes": 60,
    "MaxConsecutiveFailuresBeforeDeactivate": 10
  },
  "RealtimePolling": {
    "IntervalSeconds": 30,
    "MaxConsecutiveFailuresBeforeDeactivate": 10
  },
  "Reconciliation": {
    "AutoMergeNameThreshold": 0.90,
    "AutoMergeDistanceMeters": 100,
    "ManualReviewNameThreshold": 0.70,
    "ManualReviewDistanceMeters": 300
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5000"
      },
      "Https": {
        "Url": "https://0.0.0.0:5001"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "TransitInfoAPI": "Information",
      "Microsoft.Hosting.Lifetime": "Warning",
      "System.Net.Http": "None",
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None"
    }
  },
  "Jwt": {
    "Key": "CHANGE-ME",
    "Issuer": "TransitInfoAPI",
    "Audience": "TransitInfoApp",
    "ExpiryMinutes": 15,
    "RefreshTokenDays": 1,
    "RefreshTokenDaysRememberMe": 30
  },
  "MobilityPolling": {
    "IntervalSeconds": 120,
    "MaxConsecutiveFailuresBeforeDeactivate": 10,
    "InitialDelaySeconds": 15
  },
  "Mobility": {
    "NextbikeWorldwide": false
  },
  "PlaceMatching": {
    "MaxDistanceMeters": 50000,
    "DefaultCountryIsoCode": "HR"
  },
  "FeedImport": {
    "BulkCommandTimeoutSeconds": 600
  },
  "Routing": {
    "Timezone": "Europe/Zagreb",
    "Scope": {
      "MinLat": 42.0,
      "MinLon": 13.0,
      "MaxLat": 46.6,
      "MaxLon": 19.5
    },
    "OsmExtract": {
      "Path": null,
      "BoundingBox": {
        "MinLat": 42.0,
        "MinLon": 13.0,
        "MaxLat": 46.6,
        "MaxLon": 19.5
      },
      "RefreshIntervalHours": 24,
      "Regions": [
        {
          "Name": "croatia",
          "GeofabrikPath": "europe/croatia"
        }
      ]
    },
    "Otp": {
      "Endpoint": null
    }
  },
  "Alerts": {
    "Sources": [
      {
        "Id": "zet-izmjene",
        "OperatorSlug": "zet",
        "Kind": "Transit",
        "Format": "Html",
        "Url": "https://www.zet.hr/aktualnosti/izmjene-u-prometu/31",
        "ItemSelector": "a[href*=\"/izmjene-u-prometu/\"]",
        "Fields": {},
        "Enabled": true,
        "IntervalMinutes": 15
      },
      {
        "Id": "hzpp-info",
        "OperatorSlug": "hzpp",
        "Kind": "Transit",
        "Format": "Html",
        "Url": "https://www.hzpp.hr/hr/informacije?type=info",
        "ItemSelector": "div.accordion-item.railway-works-accordion",
        "Fields": {
          "Title": "button, .accordion-button, h3, h4",
          "Description": "div.text-container",
          "Category": "div.status"
        },
        "Enabled": true,
        "IntervalMinutes": 15
      },
      {
        "Id": "autotrolej-obavijesti",
        "OperatorSlug": "autotrolej",
        "Kind": "Transit",
        "Format": "Html",
        "Url": "https://www.autotrolej.hr/obavijesti/",
        "ItemSelector": "div.news-content",
        "Fields": {
          "Title": "h3 a, h4 a",
          "Description": "p",
          "Date": "div.news-meta",
          "Category": "div.news-meta"
        },
        "Enabled": true,
        "IntervalMinutes": 15
      },
      {
        "Id": "split-obavijesti",
        "OperatorSlug": "promet-split",
        "Kind": "Transit",
        "Format": "Html",
        "Url": "https://www.promet-split.hr/obavijesti/category/obavijesti",
        "ItemSelector": "article.c-article-card",
        "Fields": {
          "Title": "h2, h3, .c-article-card__title, a",
          "Description": ".c-article-card__summary",
          "Date": ".c-article-card__date",
          "Category": ".c-article-card__label"
        },
        "Enabled": true,
        "IntervalMinutes": 15
      },
      {
        "Id": "osijek-promet",
        "OperatorSlug": "gpp-osijek",
        "Kind": "Transit",
        "Format": "Html",
        "Url": "https://web.gpp-osijek.com/kategorija/promet/",
        "ItemSelector": "div.entry-main",
        "Fields": {
          "Title": "h2 a, h3 a, .entry-title a",
          "Description": ".entry-content",
          "Date": ".entry-date",
          "Category": ".entry-category"
        },
        "Enabled": true,
        "IntervalMinutes": 15
      },
      {
        "Id": "pulapromet-novosti",
        "OperatorSlug": "pulapromet",
        "Kind": "Transit",
        "Format": "Html",
        "Url": "https://www.pulapromet.hr/novosti",
        "ItemSelector": "a[href*=\"/novosti/detaljnije/\"]",
        "Fields": {},
        "Enabled": true,
        "IntervalMinutes": 15
      },
      {
        "Id": "jadrolinija-notices",
        "OperatorSlug": "jadrolinija",
        "Kind": "Transit",
        "Format": "Html",
        "Url": "https://www.jadrolinija.hr/en/user-notifications;https://www.jadrolinija.hr/news-single/stanje-u-pomorskom-prometu",
        "ItemSelector": "article.card",
        "Fields": {
          "Title": ".card__title, h3, h2, a",
          "Description": ".card__data, p, .card__text",
          "Category": ".card__label"
        },
        "Enabled": true,
        "IntervalMinutes": 15
      },
      {
        "Id": "hak-events",
        "Kind": "Road",
        "Format": "GeoJson",
        "Url": "https://b2b.promet-info.hr/dc/b2b.hak.events.geojson.hr_HR",
        "ItemSelector": "features",
        "Fields": {},
        "Enabled": true,
        "IntervalMinutes": 15
      },
      {
        "Id": "hak-roadworks",
        "Kind": "Road",
        "Format": "GeoJson",
        "Url": "https://b2b.promet-info.hr/dc/b2b.hak.roadworks.geojson.hr_HR",
        "ItemSelector": "features",
        "Fields": {},
        "Enabled": true,
        "IntervalMinutes": 15
      }
    ]
  },
  "Geocoding": {
    "AzureMapsKey": null,
    "BaseUrl": "https://atlas.microsoft.com",
    "CountrySet": "HR",
    "Limit": 5,
    "Viewport": {
      "MinLat": 45.60,
      "MinLon": 15.70,
      "MaxLat": 45.95,
      "MaxLon": 16.25
    }
  },
  "AllowedHosts": "*"
}
